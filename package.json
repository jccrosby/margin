{
  "name": "@jccrosby/margin",
  "version": "0.1.0",
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "bin": {"margin": "dist/margin.js"},
  "files": ["dist/*.js"],
  "os": ["darwin"],
  "engines": {"node": ">=26 <27"},
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "release:bootstrap": "bash scripts/bootstrap-release.sh",
    "release:verify": "bash scripts/verify-release.sh",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "6.0.3"
  }
}
