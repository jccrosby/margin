{
  "name": "@jccrosby/margin",
  "version": "0.1.0",
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "bin": {"margin": "dist/margin.js"},
  "files": ["dist/*.js", "dist/macos.node", "dist/windows.node"],
  "os": ["darwin", "win32"],
  "cpu": ["arm64", "x64"],
  "engines": {"node": ">=26 <27"},
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && tsc -p tsconfig.build.json && node scripts/build-native.js",
    "prepack": "pnpm run build",
    "release:bootstrap": "bash scripts/bootstrap-release.sh",
    "release:verify": "bash scripts/verify-release.sh",
    "test": "node scripts/build-native.js && node --test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "6.0.3"
  }
}
